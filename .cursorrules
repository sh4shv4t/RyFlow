│   └── p2p/          discovery.js
├── frontend/src/
│   ├── pages/
│   ├── components/   layout/, editor/, canvas/, graph/,
│   │                 ai/, tasks/, shared/, workspace/
│   ├── hooks/        useCollaboration, useOllama, useGraph, useVoice
│   ├── store/        useStore.js (Zustand)
