# Backend server port
PORT=3001

# Ollama local API — change host when Ollama runs in a separate container or machine
OLLAMA_HOST=http://localhost:11434

# Whisper.cpp binary and model paths (required for voice transcription)
# Windows example: .\whisper.cpp\main.exe
# macOS/Linux example: ./whisper.cpp/main
WHISPER_PATH=./whisper.cpp/main
WHISPER_MODEL=./whisper.cpp/models/ggml-base.bin

# Data directory for SQLite workspace files (default: ~/.ryflow)
RYFLOW_DATA_DIR=~/.ryflow

# Optional: pin the MCP server to a specific workspace ID instead of the active session
# RYFLOW_MCP_WORKSPACE_ID=
